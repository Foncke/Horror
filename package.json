{
  "name": "horror-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Video studio: Remotion animation + Python sound/texture/transcription tooling",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "studio": "remotion studio",
    "render": "remotion render",
    "room414:align": "python3 tools/align.py projects/room414/voice.mp3 projects/room414/script.txt projects/room414/timings.json",
    "room414:mix": "python3 projects/room414/mix.py",
    "room414:render": "remotion render Room414 out/Room414.mp4",
    "3am:estimate": "node tools/estimate_timings.mjs projects/3am/script.txt projects/3am/timings.json",
    "3am:align": "python3 tools/align.py projects/3am/voice.mp3 projects/3am/script.txt projects/3am/timings.json",
    "3am:mix": "python3 projects/3am/mix.py",
    "3am:render": "remotion render ThreeAM out/3AM.mp4",
    "foundyou:align": "python3 tools/align.py projects/foundyou/voice.mp3 projects/foundyou/script.txt projects/foundyou/timings.json",
    "foundyou:mix": "python3 projects/foundyou/mix.py",
    "foundyou:render": "remotion render FoundYou out/FoundYou.mp4",
    "phipop:align": "python3 tools/align.py projects/phipop/voice.mp3 projects/phipop/script.txt projects/phipop/timings.json",
    "phipop:mix": "python3 projects/phipop/mix.py",
    "phipop:render": "remotion render PhiPop out/PhiPop.mp4",
    "stills": "node tools/stills.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/media": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/three": "4.0.545",
    "gsap": "^3.15.1",
    "lucide-react": "^1.81.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.545",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/three": "^0.187.0",
    "typescript": "~5.9.0"
  }
}
